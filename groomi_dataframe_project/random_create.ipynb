import pandas as pd
import random

random.seed(42)

이름_앞 = ["구름", "새싹", "푸루", "구루움", "달빛", "별이", "몽실", "포포", "두리", "송이",
          "콩이", "보리", "미미", "루비", "초코", "하늘", "바람", "여울", "솜이", "나비"]
이름_뒤 = ["이", "미", "롱", "우", "야", "찌"]

종족_목록 = ["귀여운 비숑", "고양이", "다람쥐", "강아지", "토끼", "햄스터", "여우", "너구리",
            "고슴도치", "부엉이", "판다", "펭귄"]

특징1_목록 = ["귀여움", "고양이", "산", "고요함", "활발함", "느긋함", "장난꾸러기", "겁쟁이", "용감함"]
특징2_목록 = ["착함", "나쁨", "순함", "예민함", "다정함", "무뚝뚝함"]
특징3_목록 = ["순수함", "잠 잘잠", "나쁨", "먹보", "게으름", "호기심 많음", "수다쟁이"]

columns = ["이름", "종족", "나이", "특징11", "특징22", "특징33", "점수"]
values = []

for i in range(100):
    이름 = random.choice(이름_앞) + random.choice(이름_뒤)
    종족 = random.choice(종족_목록)
    나이 = random.randint(1, 15)
    특징11 = random.choice(특징1_목록)
    특징22 = random.choice(특징2_목록)
    특징33 = random.choice(특징3_목록)
    점수 = random.randint(1, 300)
    values.append([이름, 종족, 나이, 특징11, 특징22, 특징33, 점수])

df = pd.DataFrame(values, columns=columns)
df
