#너무 숫자가 클 경우에는

import numpy as np

a = np.array([1010.0, 1000.0, 990.0])

c = np.max(a)

exp_a = np.exp(a - c)
print(exp_a)

sum_exp_a = np.sum(np.exp(a - c))
print(sum_exp_a)

y = exp_a / sum_exp_a
print(y)
