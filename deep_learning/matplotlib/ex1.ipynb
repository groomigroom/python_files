import numpy as np
import matplotlib.pyplot as plt
x = np.arange(-22, 22, 0.1) #0에서 6까지 0.1 간격으로 생성
y1 = np.sin(x)
y2 = np.cos(x)

plt.plot(x, y1, label='sin')
plt.plot(x, y2, linestyle=':', label='cos')
plt.xlabel('goox')
plt.ylabel('remy')
plt.title('singroom & cosgroom')
plt.legend()
plt.show()


