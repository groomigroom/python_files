import nltk
nltk.download('punkt_tab') 
from nltk.tokenize import word_tokenize
from nltk.tokenize import WordPunctTokenizer
from tensorflow.keras.preprocessing.text import text_to_word_sequence
print('단어 토큰화1:', word_tokenize('Kim groomi does\'nt like rice because of bi\'world'))
#'가 들어간 거 토큰화 시킬 때는 아래와 같이
print('단어 토큰화1:', WordPunctTokenizer().tokenize('Kim groomi does\'nt like rice because of bi\'world'))
#아래꺼는 싹 다 소문자화
print('단어 토큰화1:', text_to_word_sequence('Kim groomi does\'nt like rice because of bi\'world'))


