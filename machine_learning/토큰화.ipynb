import nltk
nltk.download('punkt_tab')
from nltk.tokenize import TreebankWordTokenizer

tokenizer = TreebankWordTokenizer()
#이거는 -으로 구성된 단어는 하나로 유지함. doesn't와 같은거는 does와 n't로 나눠진다.
#!같은거도 따로 분리됨
test = "kim-groomi is cute dog and doesn\'t like rice and like older brother!!"
print(tokenizer.tokenize(test))


