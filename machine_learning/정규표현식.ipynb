# ?는 ? 앞의 문자가 존재할 수도 있고, 존재하지 않을 수도 있는 경우를 나타냄
import re
r = re.compile("ab?c")
r.search("abbc")
#출력값 x
r.search("abc")
#<re.Match object; span=(0, 3), match='abc'>
r.search("ac")
#<re.Match object; span=(0, 2), match='ac'>
r.search("bc")
#출력값 x

