#sub()는 정규 표현식 패턴과 일치하는 문자열을 찾아 다른 문자열로 대체하는 거.
import re
text = "kimgroomi is : puppy, and on the world.... cutest:: groomi"
result = re.sub("[^a-zA-Z]", " ", text)
print(result)
#kimgroomi is   puppy  and on the world     cutest   groomi

---------------------------------------

#findall()은 정규 표현식과 매치되는 모든 문자열들을 리스트로 반환함.
import re
text = "김구름의 전화번호는 010-0000-0000 입니다."
re.findall(".구.", text)
#['김구름']
---------------------------------------


#findall()은 정규 표현식과 매치되는 모든 문자열들을 리스트로 반환함.
import re
text = "김구름의 전화번호는 010-0000-0000 입니다."
re.findall("\d+", text)
#\d+는 숫자 문자를 고르는 거
#['010', '0000', '0000']

