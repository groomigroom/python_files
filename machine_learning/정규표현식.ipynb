# . 는 한 개의 임의의 문자를 나타냄 \n은 제외됨

import re
r = re.compile("a.c")
#r.search("kkk")
# 출력값 없음
#r.search("abc")
#<re.Match object; span=(0, 3), match='abc'>
r.search("acc")
#<re.Match object; span=(0, 3), match='acc'>


---------------------------------------


# ?는 ? 앞의 문자가 존재할 수도 있고, 존재하지 않을 수도 있는 경우를 나타냄
import re
r = re.compile("ab?c")
r.search("abbc")
#출력값 x
r.search("abc")
#<re.Match object; span=(0, 3), match='abc'>
r.search("ac")
#<re.Match object; span=(0, 2), match='ac'>
r.search("bc")
#출력값 x

------------------------------------------------------------------------------



# *는 바로 앞의 문자가 0개 이상일 경우를 나타냄
import re
r = re.compile("ab*c")

r.search("ac")
#<re.Match object; span=(0, 2), match='ac'>
#r.search("abbc")
#<re.Match object; span=(0, 4), match='abbc'>
#r.search("abbbbc")
#<re.Match object; span=(0, 6), match='abbbbc'>


------------------------------------------------------------------------------


# +는 바로 앞의 문자가 1개 이상일 경우를 나타냄
import re
r = re.compile("ab+c")

r.search("ac")
#출력값 x
r.search("abbc")
#<re.Match object; span=(0, 4), match='abbc'>
r.search("abbbbc")
#<re.Match object; span=(0, 6), match='abbbbc'>
r.search("abc")
#<re.Match object; span=(0, 3), match='abc'>


------------------------------------------------------------------------------



