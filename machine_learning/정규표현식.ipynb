from nltk.tokenize import RegexpTokenizer
text = "groomi\'s favortie is brother. and he is alway sleep. cute puppy zzz.!! 1!"

tokenizer1 = RegexpTokenizer('[\w]+')
#문자 또는 숫자가 1개 이상인 경우
tokenizer2 = RegexpTokenizer("\s+", gaps=True)
#띄어쓰기로 구분 그리고, gaps=True는 정규 표현식을 토큰으로 나누기 위한 기준으로 사용한다는 의미
print(tokenizer1.tokenize(text))
#['groomi', 's', 'favortie', 'is', 'brother', 'and', 'he', 'is', 'alway', 'sleep', 'cute', 'puppy', 'zzz', '1']
print(tokenizer2.tokenize(text))
#["groomi's", 'favortie', 'is', 'brother.', 'and', 'he', 'is', 'alway', 'sleep.', 'cute', 'puppy', 'zzz.!!', '1!']

