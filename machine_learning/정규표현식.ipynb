# +는 바로 앞의 문자가 1개 이상일 경우를 나타냄
import re
r = re.compile("ab+c")

r.search("ac")
#출력값 x
r.search("abbc")
#<re.Match object; span=(0, 4), match='abbc'>
r.search("abbbbc")
#<re.Match object; span=(0, 6), match='abbbbc'>
r.search("abc")
#<re.Match object; span=(0, 3), match='abc'>


------------------------------------------------------------------------------


# ^는 시작되는 문자열을 지정
import re
r = re.compile("^ab")

r.search("ac")
#출력값 x
r.search("abc")
#<re.Match object; span=(0, 2), match='ab'>
r.search("bcd")
#출력값 x
r.search("ab")
#<re.Match object; span=(0, 2), match='ab'>

