# {숫자} 기호는 해당 문자를 숫자만큼 반복한 것을 나타냄
import re
r = re.compile("ab{2}c")

r.search("ac")
#출력값 x
r.search("abc")
#출력값 x
r.search("abbc")
#<re.Match object; span=(0, 4), match='abbc'>
r.search("abbbbc")
#출력값 x

