#띄어쓰기로 분리하기 전처리 예제
import re
text = """groomi mungmung
kkamjjik mungmung
kekeke super mungmung keke"""
re.split("\s+", text)
"""['groomi',
 'mungmung',
 'kkamjjik',
 'mungmung',
 'kekeke',
 'super',
 'mungmung',
 'keke']"""

