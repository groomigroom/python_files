#match는 앞에서부터 검사함. .은 임의의 1글자
import re
r = re.compile("ab.")
r.match("kkkabc")
# no result xxx
r.match("abckkk")
#<re.Match object; span=(0, 3), match='abc'>

---------------------------------------

#[^문자]는 ^기호 뒤에 붙은 문자들을 제외한 모든 문자를 매치하는 역할을 합니다. 
import re
r = re.compile("[^abc]")

r.search("ac")
# no result xxx
r.search("a")
# no result xxx
r.search("d")
#<re.Match object; span=(0, 1), match='d'>

---------------------------------------

# [] 안에 있는 문자열의 모든 부분으로서 1개의 문자와 match하는 거
import re
r = re.compile("[abc]")

r.search("ac")
#<re.Match object; span=(0, 1), match='a'>
r.search("a")
#<re.Match object; span=(0, 1), match='a'>
r.search("b")
#<re.Match object; span=(0, 1), match='b'>
r.search("c")
#<re.Match object; span=(0, 1), match='c'>
r.search("bc")
#<re.Match object; span=(0, 1), match='b'>
r.search("abc")
#<re.Match object; span=(0, 1), match='a'>
r.search("zz")
#no result xxx


