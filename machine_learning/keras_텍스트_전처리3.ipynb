from tensorflow.keras.preprocessing.text import Tokenizer
preprocessed_sentences = [['barber', 'person'], ['barber', 'good', 'person'], ['barber', 'huge', 'person'], ['knew', 'secret'], ['secret', 'kept', 'huge', 'secret'], ['huge', 'secret'], ['barber', 'kept', 'word'], ['barber', 'kept', 'word'], ['barber', 'kept', 'secret'], ['keeping', 'keeping', 'huge', 'secret', 'driving', 'barber', 'crazy'], ['barber', 'went', 'huge', 'mountain']]
tokenizer = Tokenizer()
tokenizer.fit_on_texts(preprocessed_sentences)
#fit_on_texts()는 빈도수를 기준으로 단어 집합을 생성
#아래와 같이 하면 각 단어를 이미 정해진 인덱스로 변환하는데, 상위 5개의 단어만을 사용하겠다고 지정
vocab_size = 5
tokenizer = Tokenizer(num_words=vocab_size + 2, oov_token="OOV")
tokenizer.fit_on_texts(preprocessed_sentences)
#기본적으로 단어 집합에 없는 단어인 OOV에 대해서는 단어를 정수로 바꾸는 과정에서 아예 단어를 제거함. => 따라서 단어 집합에 없는 단어들은 OOV로 간주하여 보존하고 싶다면, oov_token을 사용하기
print("단어 OOV의 인덱스: {}".format(tokenizer.word_index["OOV"]))
print(tokenizer.texts_to_sequences(preprocessed_sentences))
