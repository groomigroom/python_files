import pandas as pd
from math import log

docs = [
    "귀여운 김구름이",
    "구름이 멍멍",
    "비숑 김구름",
    "구름이 멍멍구름"
]
vocab = list(set(w for doc in docs for w in doc.split()))
vocab.sort()

N = len(docs)

def tf(t, d):
    return d.count(t)

def idf(t):
    df = 0
    for doc in docs:
        df += t in doc
    return log(N/(df + 1))

def tfidf(t, d):
    return tf(t,d)* idf(t)

    
