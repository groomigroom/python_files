import tensorflow as tf


#------------


tf.__version__


#---------------


mnist = tf.keras.datasets.mnist

(x_train, y_train), (x_test, y_test) = mnist.load_data()
x_train, x_test = x_train / 255.0, x_test / 255.0


#-------------


"""

제공해주신 코드는 텐서플로(TensorFlow)를 사용하여 MNIST 손글씨 데이터셋을 불러오고 전처리(정규화)하는 과정을 담고 있습니다.
인공지능 모델 학습을 시작할 때 가장 기본적으로 사용하는 데이터 준비 단계입니다. 코드의 한 줄 한 줄의 의미는 다음과 같습니다.
## 🔍 코드 한 줄씩 뜯어보기

* mnist = tf.keras.datasets.mnist
* 텐서플로에서 기본으로 제공하는 MNIST 손글씨 데이터셋을 가져옵니다. 이 데이터셋은 0부터 9까지의 숫자 손글씨 이미지(28x28 픽셀)로 구성되어 있습니다.
* (x_train, y_train), (x_test, y_test) = mnist.load_data()
* 데이터를 학습용(Train)과 검증용(Test)으로 자동 분리하여 다운로드합니다.
   * x_train, x_test: 숫자 이미지 데이터 (학습용 60,000장, 검증용 10,000장)
   * y_train, y_test: 각 이미지가 실제로 어떤 숫자인지 나타내는 정답(레이블) 데이터
* x_train, x_test = x_train / 255.0, x_test / 255.0
* 이미지의 픽셀 값을 0.0 ~ 1.0 사이의 값으로 정규화(Normalization)하는 과정입니다.
   * 원래 흑백 이미지의 픽셀 값은 0(검은색)부터 255(흰색) 사이의 정수를 가집니다. 이를 데이터의 최대치인 255.0으로 나누어 실수(Float) 형태로 변환합니다.

## 💡 왜 255로 나누어 전처리를 하나요?
인공지능(딥러닝) 모델은 입력되는 데이터의 범위가 너무 크면(예: 0~255) 학습 속도가 느려지거나 최적의 답을 찾지 못하고 헤맬 수 있습니다. 입력값을 0과 1 사이의 작은 범위로 맞추어 주면 모델이 더 빠르고 안정적으로 학습할 수 있습니다.
------------------------------
이 데이터셋을 활용해 어떤 형태의 딥러닝 모델(예: DNN, CNN 등)을 구축하고 싶으신가요? 모델 생성 및 학습 코드 작성이 필요하시면 말씀해 주세요!



"""


#------

model = tf.keras.models.Sequential([
    # 1. 입력 데이터의 형태를 정의하는 Input 레이어를 가장 먼저 배치합니다.
    tf.keras.layers.Input(shape=(28, 28)),
    
    # 2. Flatten 레이어에서는 input_shape를 제거합니다.
    tf.keras.layers.Flatten(),
    
    tf.keras.layers.Dense(128, activation='relu'),
    tf.keras.layers.Dropout(0.2),
    tf.keras.layers.Dense(10, activation='softmax')
])

model.compile(optimizer='adam',
              loss='sparse_categorical_crossentropy',
              metrics=['accuracy'])


#----------


아무 일도 일어나지 않는 것처럼 보이는 것은 정상입니다.
제공해주신 코드는 모델의 구조를 정의하고 학습 방법(컴파일)을 설정하는 설계 단계이기 때문입니다. 모니터에 실행 결과나 그래프가 찍히려면, 실제로 데이터를 집어넣고 학습을 시작하라는 명령어(model.fit)를 내려주어야 합니다.
코랩(Colab) 셀에 아래 코드를 추가하고 실행하시면 화면에 학습 과정(Loss, Accuracy 등)이 실시간으로 출력될 것입니다.
------------------------------
## 🚀 학습 시작 코드 (아래 코드를 실행해 보세요)

# 5번 반복(Epochs)하여 모델을 학습시킵니다.
model.fit(x_train, y_train, epochs=5)

## 📊 학습 완료 후 성능 평가하기
학습이 끝난 후, 모델이 새로운 데이터도 잘 맞추는지 검증하려면 아래 코드를 이어서 실행하시면 됩니다.

# 검증용 데이터(Test data)로 모델의 최종 정확도를 확인합니다.
model.evaluate(x_test, y_test, verbose=2)

------------------------------
위 코드를 실행하면 숫자가 올라가면서 학습이 진행될 것입니다. 혹시 실행 중에 또 다른 문구나 에러가 발생하면 언제든 편하게 말씀해 주세요!

